# ════════════════════════════════════════════════════════════════
#  이 파일을 복사해서 .env 로 저장하고 값을 채우세요
#  cp .env.example .env
# ════════════════════════════════════════════════════════════════

# ─── 앱 기본 ────────────────────────────────────────────────────
APP_NAME=식당 추천 API
DEBUG=true          # 운영 배포 시 false 로 변경

# ─── 데이터베이스 ────────────────────────────────────────────────
# 로컬 개발: SQLite (아무 설정 불필요)
DATABASE_URL=sqlite:///./restaurant.db

# Railway 배포: PostgreSQL 플러그인 추가 시 자동 주입됨
# (Railway 대시보드에서 Variables 탭에 DATABASE_URL 확인)
# DATABASE_URL=postgresql://user:password@host:5432/railway

# ─── JWT 보안 키 ─────────────────────────────────────────────────
# 운영 환경에서는 반드시 아래 명령으로 강력한 랜덤 키 생성:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-in-production-32chars!!

# ─── CORS ────────────────────────────────────────────────────────
# 개발: * (전체 허용)
# 운영: Railway URL 입력 (예: https://bob-meal.up.railway.app)
ALLOWED_ORIGINS=*

# ─── 네이버 오픈API ───────────────────────────────────────────────
# 발급: https://developers.naver.com/apps/#/register
# 사용 API: 검색 (블로그)
# 비워두면 목업 가격 데이터 사용
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ─── 카카오 REST API ─────────────────────────────────────────────
# 발급: https://developers.kakao.com/
# 사용 API: 카카오 모빌리티 (경로 시간 계산) — Phase 2
KAKAO_REST_API_KEY=

# ─── Google Maps API ─────────────────────────────────────────────
# 발급: https://console.cloud.google.com/
# 사용 API: Places API (Popular Times 혼잡도) — Phase 2
GOOGLE_MAPS_API_KEY=

# ─── 기상청 오픈API ───────────────────────────────────────────────
# 발급: https://www.data.go.kr/data/15084084/openapi.do
# "활용신청" → 일반 인증키 (Encoding) 복사
# 비워두면 목업 날씨 데이터 사용
KMA_SERVICE_KEY=
