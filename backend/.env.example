# 복사 후 .env 로 저장하세요
APP_NAME=식당 추천 API
DEBUG=true

# 데이터베이스 (개발: SQLite / 운영: PostgreSQL)
DATABASE_URL=sqlite:///./restaurant.db
# DATABASE_URL=postgresql://user:password@localhost:5432/restaurant_db

# JWT (운영 환경에서 반드시 강력한 랜덤 값으로 교체)
SECRET_KEY=changeme-in-production-32chars!!

# Phase 2 — 외부 API 키 (지금은 비워도 됩니다)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_REST_API_KEY=
GOOGLE_MAPS_API_KEY=
KMA_SERVICE_KEY=
